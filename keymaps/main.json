{
  // :not([mini]) so these never reach a find field or a commit box, matching
  // tasklist-tools. The handlers act on the file the grammar belongs to.
  "lumine-text-editor[data-grammar~=\"latex\"]:not([mini])": {
    "f5": "latex-tools:compile",
    "alt-f5": "latex-tools:toggle-compile-on-save",
    "ctrl-f5": "latex-tools:interrupt",
    "f6": "latex-tools:clean",
    "alt-f6": "latex-tools:clean-linter",
    "ctrl-f6": "latex-tools:kill-and-clean",
    // typst-tools binds the same command; this one had it in the menu alone.
    "shift-f5": "latex-tools:interrupt-all",
    "f7": "latex-tools:open-pdf",
    "alt-f7": "latex-tools:synctex",
    "f8": "latex-tools:open-pdf-external"
  },
  ".latex-tools-observed-files-list": {
    "ctrl-d": "latex-tools:unobserve-selected-file"
  }
}
